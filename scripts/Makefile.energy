aire_manchester_EPCG_and_GBIS: MODE=energy_manchester_scaled
aire_manchester_EPCG_and_GBIS:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'EPCGandGBIS'

aire_manchester_FFRS: RUN_CONFIG=$(CONFIG)/energy_manchester_scaled.yaml
aire_manchester_FFRS: MODE=energy_manchester_scaled
aire_manchester_FFRS:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'fossilFuelReplacementScheme'

aire_all_manchester: aire_manchester_housing_baseline aire_manchester_goodHeatingDummy aire_manchester_EPCG
aire_all_manchester: aire_manchester_GBIS aire_manchester_EPCG_and_GBIS aire_manchester_noEnergyPriceIncrease