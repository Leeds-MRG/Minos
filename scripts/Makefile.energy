#######################
# Aspatial model runs #
#######################

################################
# Aspatial Housing Single Runs #
################################

housing_baseline: ### Baseline run of MINOS, using configuration defined in testConfig.yaml
housing_baseline: RUN_CONFIG=config/energy_default.yaml
housing_baseline: MODE=energy_default_config
housing_baseline:
	$(PYTHON) scripts/run.py -c $(RUN_CONFIG) -o $(MODE)

intervention_EPCG:
	$(PYTHON) scripts/run.py -c $(RUN_CONFIG) -o $(MODE) -i 'EPCG'

intervention_goodHeatingDummy:
	$(PYTHON) scripts/run.py -c $(RUN_CONFIG) -o $(MODE) -i 'goodHeatingDummy'

intervention_GBIS:
	$(PYTHON) scripts/run.py -c $(RUN_CONFIG) -o $(MODE) -i 'GBIS'

intervention_EPCG_and_GBIS:
	$(PYTHON) scripts/run.py -c $(RUN_CONFIG) -o $(MODE) -i 'EPCGandGBIS'

intervention_fossilFuelReplacementScheme:
	$(PYTHON) scripts/run.py -c $(RUN_CONFIG) -o $(MODE) -i 'fossilFuelReplacementScheme'

#######################################
# ARC4 Aspatial Housing Interventions #
#######################################

aire_housing_baseline: MODE = energy_default_config
aire_housing_baseline: RUN_CONFIG = $(CONFIG)/energy_default.yaml
aire_housing_baseline:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE)

aire_aspatial_goodHeatingDummy: RUN_CONFIG = $(CONFIG)/energy_default.yaml
aire_aspatial_goodHeatingDummy: MODE = energy_default_config
aire_aspatial_goodHeatingDummy:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'goodHeatingDummy'

aire_aspatial_GBIS: RUN_CONFIG = $(CONFIG)/energy_default.yaml
aire_aspatial_GBIS: MODE = energy_default_config
aire_aspatial_GBIS:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'GBIS'

aire_aspatial_FFRS: RUN_CONFIG = $(CONFIG)/energy_default.yaml
aire_aspatial_FFRS: MODE = energy_default_config
aire_aspatial_FFRS:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'fossilFuelReplacementScheme'

###########################
# Manchester Spatial data #
###########################

######################################
# Manchester Individual Housing Runs #
######################################

