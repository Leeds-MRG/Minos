########################################
# ARC Manchester Housing Interventions #
########################################

aire_manchester_housing_baseline: MODE=energy_manchester_scaled
aire_manchester_housing_baseline: RUN_CONFIG=$(CONFIG)/energy_manchester_scaled.yaml
aire_manchester_housing_baseline:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE)

aire_manchester_noEnergyPriceIncrease: RUN_CONFIG=$(CONFIG)/energy_manchester_scaled.yaml
aire_manchester_noEnergyPriceIncrease: MODE=energy_manchester_scaled
aire_manchester_noEnergyPriceIncrease:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'noEnergyPriceIncrease'


aire_manchester_goodHeatingDummy: RUN_CONFIG=$(CONFIG)/energy_manchester_scaled.yaml
aire_manchester_goodHeatingDummy: MODE=energy_manchester_scaled
aire_manchester_goodHeatingDummy:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'goodHeatingDummy'

aire_manchester_EPCG: RUN_CONFIG=$(CONFIG)/energy_manchester_scaled.yaml
aire_manchester_EPCG: MODE=energy_manchester_scaled
aire_manchester_EPCG:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'EPCG'

aire_manchester_GBIS: RUN_CONFIG=$(CONFIG)/energy_manchester_scaled.yaml
aire_manchester_GBIS: MODE=energy_manchester_scaled
aire_manchester_GBIS:
	bash scripts/aire_submit.sh -c $(RUN_CONFIG) -o $(MODE) -i 'GBIS'

